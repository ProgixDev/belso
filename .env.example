# Copy to .env.local and fill in real values (never commit real env files).
# Server vars are parsed in src/core/env.ts (server-only); client vars in
# src/core/env.client.ts. Unparsed env access fails review.
#
# ⚠️  NEXT_PUBLIC_* is inlined into the BROWSER bundle — never put a secret there.

# NODE_ENV is set by Next.js automatically.

# --- Database (ADR-0008, spec 010) -------------------------------------------
# Postgres on our own VPS. Server-only: it carries a password, so the
# NEXT_PUBLIC_ spelling would be wrong and `pnpm secrets:check` would say so.
#
# Port 5432 is NOT exposed to the internet — it is bound to the VPS's loopback,
# so local development reaches it through an SSH tunnel:
#
#   pnpm db:tunnel                      # ssh -N -L 55432:127.0.0.1:5432 belso-vps
#   pnpm db:migrate && pnpm db:seed
#
# The password lives only in /docker/belso-db/.env on the server (chmod 600).
# Leave this blank and the site serves today's fixtures instead — which is the
# normal state for `pnpm verify` and for a fresh clone.
#
# This connects as `belso_app`, which can read published listings and insert an
# enquiry and can do nothing else (db/migrations/0004_app_role.sql).
DATABASE_URL=

# --- The back-office's own connection (ADR-0010, spec 011) -------------------
# Connects as `belso_editor`: it writes listings, and it cannot read an enquiry
# or delete a listing. Provisioned by scripts/vps/belso-roles.sh.
#
# ⚠️  Never set this to the same value as DATABASE_URL. The two roles existing
# separately is the whole control — a fallback would hand the public-facing
# connection the ability to rewrite the catalogue, while looking like a
# convenience to whoever set it. src/core/env.ts refuses to fall back for you.
#
# Blank is fine everywhere except production: /admin reports itself
# unconfigured, the storefront is unaffected, and the boot warns.
DATABASE_EDITOR_URL=

# Keys the HMAC over visitor IP networks in the enquiry throttle, and over the
# sign-in throttle's two axes. Unset it degrades to a plain hash rather than
# failing open — but set it in production, or a database dump plus a few minutes
# of brute force reveals which network enquired.
THROTTLE_SECRET=

# Where uploaded photographs are written (spec 011). Defaults to ./media.
# NOT public/ — Next serves that from a build-time manifest, so a file written
# at runtime is a file nothing will serve until the next deploy. In production
# this points at a mounted volume that survives a container rebuild; get it
# wrong and the client's photography disappears on the next deploy.
# MEDIA_ROOT=/var/lib/belso/media

# --- Map tiles (ADR-0009, spec 009) ------------------------------------------
# Public by design and domain-restricted at the provider. Unset, the map falls
# back to MapLibre's keyless demo tiles, which have no detail at city zoom —
# that is why the map currently renders on blank blue ground.
# NEXT_PUBLIC_MAP_STYLE_URL="https://api.maptiler.com/maps/streets-v2/style.json?key=..."
# Until this one is set, the Satellite control is hidden rather than offered broken.
# NEXT_PUBLIC_MAP_SATELLITE_STYLE_URL=""
