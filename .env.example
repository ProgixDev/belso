# Copy to .env.local and fill in real values (never commit real env files).
# Server vars are parsed in src/core/env.ts (server-only); client vars in
# src/core/env.client.ts. Unparsed env access fails review.
#
# ⚠️  NEXT_PUBLIC_* is inlined into the BROWSER bundle — never put a secret there.

# NODE_ENV is set by Next.js automatically.

# --- Database (ADR-0008, spec 010) -------------------------------------------
# Postgres on our own VPS. Server-only: it carries a password, so the
# NEXT_PUBLIC_ spelling would be wrong and `pnpm secrets:check` would say so.
#
# Port 5432 is NOT exposed to the internet — it is bound to the VPS's loopback,
# so local development reaches it through an SSH tunnel:
#
#   pnpm db:tunnel                      # ssh -N -L 55432:127.0.0.1:5432 belso-vps
#   pnpm db:migrate && pnpm db:seed
#
# The password lives only in /docker/belso-db/.env on the server (chmod 600).
# Leave this blank and the site serves today's fixtures instead — which is the
# normal state for `pnpm verify` and for a fresh clone.
DATABASE_URL=

# --- Map tiles (ADR-0009, spec 009) ------------------------------------------
# Public by design and domain-restricted at the provider. Unset, the map falls
# back to MapLibre's keyless demo tiles, which have no detail at city zoom —
# that is why the map currently renders on blank blue ground.
# NEXT_PUBLIC_MAP_STYLE_URL="https://api.maptiler.com/maps/streets-v2/style.json?key=..."
# Until this one is set, the Satellite control is hidden rather than offered broken.
# NEXT_PUBLIC_MAP_SATELLITE_STYLE_URL=""

# --- Supabase — SUPERSEDED by ADR-0008 ---------------------------------------
# Belso no longer uses Supabase: every read goes through a server-only
# repository, so RLS guarded a door nobody walks through. These are still parsed
# by src/core/env.ts and env.client.ts and are due for deletion (spec 010, T28).
# Leave them blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
