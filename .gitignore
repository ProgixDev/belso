# dependencies
node_modules/

# next.js
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# testing
coverage/
playwright-report/
test-results/

# generated evidence — curated copies live in docs/reports/<slug>/img instead
artifacts/*
!artifacts/.gitkeep

# generated report PDFs (share them, don't version them)
docs/reports/*.pdf

# env — only the example is committed
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem
.vercel
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# local agent scratch
.claude/settings.local.json
CLAUDE.local.md

# Claude Design handoff bundles — source-of-truth mockups, ~60MB of PNG/MP4.
# The assets the app actually ships are copied into public/design/.
*-handoff/

# Photographs uploaded through the back-office (MEDIA_ROOT, default ./media).
#
# The client's real photography must never enter this repository — and the e2e
# suite alone writes fifteen files here on every run. In production this path is
# a mounted volume outside the checkout; locally it is working data, like the
# database it points at.
/media/
